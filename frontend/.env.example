# ===========================================
# API CONFIGURATION
# ===========================================

# Development (default)
REACT_APP_API_URL=http://localhost:5050/api
REACT_APP_SOCKET_URL=http://localhost:5050

# Production - Uncomment and set these for production
# REACT_APP_API_URL=https://api.yourdomain.com/api
# REACT_APP_SOCKET_URL=https://api.yourdomain.com

# ===========================================
# SECURITY SETTINGS
# ===========================================

# Enable production mode (enables additional security features)
REACT_APP_NODE_ENV=development

# Token storage method (localStorage or sessionStorage)
# Note: For maximum security, consider using httpOnly cookies
REACT_APP_TOKEN_STORAGE=localStorage
